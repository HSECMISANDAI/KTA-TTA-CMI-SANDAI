rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hanya izinkan akses ke collection 'pica_findings' — bagian database
    // lain (kalau nanti ada) tetap tertutup meskipun API key diketahui orang lain.
    match /pica_findings/{docId} {
      allow read, write: if true;
    }

    // Tutup semua collection lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
